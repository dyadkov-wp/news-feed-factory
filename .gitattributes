# =============================================================================
# Нормализация переносов строк.
# =============================================================================

* text=auto eol=lf

*.php  text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.xml  text eol=lf
*.neon text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.html text eol=lf
*.txt  text eol=lf
*.pot  text eol=lf
*.po   text eol=lf

# Бинарные файлы — не трогать.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.zip  binary
*.tar  binary
*.gz   binary
*.pdf  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary

# =============================================================================
# Исключения из релизного архива (git archive).
# Файлы остаются в репозитории, но не попадают в ZIP для WordPress.org.
# =============================================================================

/.gitattributes       export-ignore
/.gitignore           export-ignore
/.github/             export-ignore
/.editorconfig        export-ignore

/vendor/              export-ignore
/composer.json        export-ignore
/composer.lock        export-ignore

/phpcs.xml.dist       export-ignore
/phpstan.neon.dist    export-ignore
/phpunit.xml.dist     export-ignore

/tests/               export-ignore
/doc/                 export-ignore

/README.md            export-ignore
/build/               export-ignore

# LICENSE НЕ исключается — по MIT он должен идти в дистрибутиве.
# readme.txt НЕ исключается — это файл для WordPress.org.
